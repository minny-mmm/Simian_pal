{
 "additionalProperties": false,
 "createOnlyProperties": [
  "/properties/Name",
  "/properties/FleetType"
 ],
 "definitions": {
  "ComputeCapacity": {
   "additionalProperties": false,
   "properties": {
    "DesiredInstances": {
     "type": "integer"
    },
    "DesiredSessions": {
     "type": "integer"
    }
   },
   "type": "object"
  },
  "DomainJoinInfo": {
   "additionalProperties": false,
   "properties": {
    "DirectoryName": {
     "type": "string"
    },
    "OrganizationalUnitDistinguishedName": {
     "maxLength": 2000,
     "minLength": 0,
     "type": "string"
    }
   },
   "type": "object"
  },
  "S3Location": {
   "additionalProperties": false,
   "properties": {
    "S3Bucket": {
     "format": "AWS::S3::Bucket.Name",
     "maxLength": 63,
     "minLength": 3,
     "pattern": "^[0-9a-z\\.\\-]*(?<!\\.)$",
     "type": "string"
    },
    "S3Key": {
     "maxLength": 1024,
     "minLength": 1,
     "type": "string"
    }
   },
   "required": [
    "S3Bucket",
    "S3Key"
   ],
   "type": "object"
  },
  "Tag": {
   "additionalProperties": false,
   "properties": {
    "Key": {
     "maxLength": 128,
     "minLength": 1,
     "pattern": "^(?!aws:)[\\S\\s]+$",
     "type": "string"
    },
    "Value": {
     "maxLength": 256,
     "pattern": "^[\\S\\s]*$",
     "type": "string"
    }
   },
   "required": [
    "Key"
   ],
   "type": "object"
  },
  "VolumeConfig": {
   "additionalProperties": false,
   "properties": {
    "VolumeSizeInGb": {
     "type": "integer"
    }
   },
   "type": "object"
  },
  "VpcConfig": {
   "additionalProperties": false,
   "properties": {
    "SecurityGroupIds": {
     "format": "AWS::EC2::SecurityGroup.Ids",
     "insertionOrder": false,
     "items": {
      "format": "AWS::EC2::SecurityGroup.Id",
      "minLength": 1,
      "type": "string"
     },
     "maxItems": 5,
     "minItems": 0,
     "type": "array",
     "uniqueItems": false
    },
    "SubnetIds": {
     "insertionOrder": false,
     "items": {
      "minLength": 1,
      "type": "string"
     },
     "type": "array",
     "uniqueItems": false
    }
   },
   "type": "object"
  }
 },
 "description": "Resource Type definition for AWS::AppStream::Fleet",
 "handlers": {
  "create": {
   "permissions": [
    "appstream:CreateFleet",
    "appstream:StartFleet",
    "appstream:DescribeFleets",
    "appstream:TagResource",
    "appstream:ListTagsForResource",
    "iam:PassRole",
    "s3:ListBucket",
    "s3:GetObject"
   ]
  },
  "delete": {
   "permissions": [
    "appstream:StopFleet",
    "appstream:DescribeFleets",
    "appstream:DeleteFleet"
   ]
  },
  "list": {
   "permissions": [
    "appstream:DescribeFleets"
   ]
  },
  "read": {
   "permissions": [
    "appstream:DescribeFleets",
    "appstream:ListTagsForResource"
   ]
  },
  "update": {
   "permissions": [
    "appstream:UpdateFleet",
    "appstream:DescribeFleets",
    "appstream:StopFleet",
    "appstream:StartFleet",
    "appstream:TagResource",
    "appstream:UntagResource",
    "appstream:ListTagsForResource",
    "iam:PassRole",
    "s3:ListBucket",
    "s3:GetObject"
   ]
  }
 },
 "primaryIdentifier": [
  "/properties/Name"
 ],
 "properties": {
  "Arn": {
   "pattern": "^arn:[a-z-]+:[a-z-]+:(([a-z]+-)+[0-9])?:([0-9]{12})?:.+$",
   "type": "string"
  },
  "AttributesToDelete": {
   "insertionOrder": false,
   "items": {
    "enum": [
     "VPC_CONFIGURATION",
     "VPC_CONFIGURATION_SECURITY_GROUP_IDS",
     "DOMAIN_JOIN_INFO",
     "IAM_ROLE_ARN",
     "USB_DEVICE_FILTER_STRINGS",
     "SESSION_SCRIPT_S3_LOCATION",
     "MAX_SESSIONS_PER_INSTANCE"
    ],
    "type": "string"
   },
   "type": "array",
   "uniqueItems": true
  },
  "ComputeCapacity": {
   "$ref": "#/definitions/ComputeCapacity"
  },
  "Description": {
   "maxLength": 256,
   "minLength": 1,
   "type": "string"
  },
  "DisableIMDSV1": {
   "type": "boolean"
  },
  "DisconnectTimeoutInSeconds": {
   "maximum": 360000,
   "minimum": 60,
   "type": "integer"
  },
  "DisplayName": {
   "maxLength": 100,
   "minLength": 1,
   "type": "string"
  },
  "DomainJoinInfo": {
   "$ref": "#/definitions/DomainJoinInfo"
  },
  "EnableDefaultInternetAccess": {
   "type": "boolean"
  },
  "FleetType": {
   "pattern": "^ALWAYS_ON$|^ON_DEMAND$|^ELASTIC$",
   "type": "string"
  },
  "IamRoleArn": {
   "format": "AWS::IAM::Role.Arn",
   "pattern": "^arn:aws(?:\\-cn|\\-iso\\-b|\\-iso|\\-us\\-gov)?:iam::[0-9]{12}:role/.+$",
   "type": "string"
  },
  "IdleDisconnectTimeoutInSeconds": {
   "maximum": 3600,
   "minimum": 0,
   "type": "integer"
  },
  "ImageArn": {
   "maxLength": 1024,
   "pattern": "^arn:[a-z-]+:[a-z-]+:(([a-z]+-)+[0-9])?:([0-9]{12})?:.+$",
   "type": "string"
  },
  "ImageName": {
   "maxLength": 100,
   "minLength": 1,
   "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,100}$",
   "type": "string"
  },
  "InstanceType": {
   "minLength": 1,
   "type": "string"
  },
  "MaxConcurrentSessions": {
   "type": "integer"
  },
  "MaxSessionsPerInstance": {
   "type": "integer"
  },
  "MaxUserDurationInSeconds": {
   "maximum": 360000,
   "minimum": 600,
   "type": "integer"
  },
  "Name": {
   "maxLength": 100,
   "minLength": 1,
   "type": "string"
  },
  "Platform": {
   "enum": [
    "AMAZON_LINUX2",
    "RHEL8",
    "ROCKY_LINUX8",
    "UBUNTU_PRO_2404",
    "WINDOWS",
    "WINDOWS_SERVER_2016",
    "WINDOWS_SERVER_2019",
    "WINDOWS_SERVER_2022",
    "WINDOWS_SERVER_2025"
   ],
   "type": "string"
  },
  "RootVolumeConfig": {
   "$ref": "#/definitions/VolumeConfig"
  },
  "SessionScriptS3Location": {
   "$ref": "#/definitions/S3Location"
  },
  "StreamView": {
   "enum": [
    "APP",
    "DESKTOP"
   ],
   "type": "string"
  },
  "Tags": {
   "insertionOrder": false,
   "items": {
    "$ref": "#/definitions/Tag"
   },
   "maxItems": 50,
   "minItems": 1,
   "type": "array",
   "uniqueItems": false
  },
  "UsbDeviceFilterStrings": {
   "insertionOrder": false,
   "items": {
    "maxLength": 100,
    "minLength": 0,
    "pattern": "^((\\w*)\\s*(\\w*)\\s*\\,\\s*(\\w*)\\s*\\,\\s*\\*?(\\w*)\\s*\\,\\s*\\*?(\\w*)\\s*\\,\\s*\\*?\\d*\\s*\\,\\s*\\*?\\d*\\s*\\,\\s*[0-1]\\s*\\,\\s*[0-1]\\s*)$",
    "type": "string"
   },
   "type": "array",
   "uniqueItems": false
  },
  "VpcConfig": {
   "$ref": "#/definitions/VpcConfig"
  }
 },
 "readOnlyProperties": [
  "/properties/Arn"
 ],
 "required": [
  "InstanceType",
  "Name"
 ],
 "sourceUrl": "https://github.com/aws-cloudformation/aws-cloudformation-resource-providers-appstream.git",
 "tagging": {
  "cloudFormationSystemTags": false,
  "permissions": [
   "appstream:TagResource",
   "appstream:ListTagsForResource",
   "appstream:UntagResource"
  ],
  "tagOnCreate": true,
  "tagProperty": "/properties/Tags",
  "tagUpdatable": true,
  "taggable": true
 },
 "typeName": "AWS::AppStream::Fleet",
 "writeOnlyProperties": [
  "/properties/AttributesToDelete"
 ]
}
