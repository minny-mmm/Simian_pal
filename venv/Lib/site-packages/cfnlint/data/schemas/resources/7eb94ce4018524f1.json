{
 "additionalIdentifiers": [
  [
   "/properties/VocabularyName"
  ]
 ],
 "additionalProperties": false,
 "createOnlyProperties": [
  "/properties/VocabularyName",
  "/properties/LanguageCode"
 ],
 "definitions": {
  "Tag": {
   "additionalProperties": false,
   "properties": {
    "Key": {
     "description": "The key of the tag.",
     "maxLength": 128,
     "minLength": 1,
     "type": "string"
    },
    "Value": {
     "description": "The value of the tag.",
     "maxLength": 256,
     "minLength": 0,
     "type": "string"
    }
   },
   "required": [
    "Key",
    "Value"
   ],
   "type": "object"
  }
 },
 "description": "Creates a custom vocabulary that you can use to improve the transcription accuracy of domain-specific words and phrases.",
 "handlers": {
  "create": {
   "permissions": [
    "transcribe:CreateVocabulary",
    "transcribe:GetVocabulary",
    "transcribe:TagResource",
    "transcribe:ListTagsForResource",
    "iam:PassRole",
    "s3:GetObject"
   ]
  },
  "delete": {
   "permissions": [
    "transcribe:DeleteVocabulary",
    "transcribe:GetVocabulary",
    "transcribe:ListTagsForResource"
   ]
  },
  "list": {
   "permissions": [
    "transcribe:ListVocabularies"
   ]
  },
  "read": {
   "permissions": [
    "transcribe:GetVocabulary",
    "transcribe:ListTagsForResource"
   ]
  },
  "update": {
   "permissions": [
    "transcribe:UpdateVocabulary",
    "transcribe:GetVocabulary",
    "transcribe:TagResource",
    "transcribe:UntagResource",
    "transcribe:ListTagsForResource",
    "iam:PassRole",
    "s3:GetObject"
   ]
  }
 },
 "primaryIdentifier": [
  "/properties/Arn"
 ],
 "properties": {
  "Arn": {
   "description": "The Amazon Resource Name (ARN) of the custom vocabulary.",
   "maxLength": 1011,
   "minLength": 1,
   "pattern": "^arn:aws(-[^:]+)?:transcribe:[a-zA-Z0-9-]*:[0-9]{12}:[a-zA-Z-]*/[0-9a-zA-Z._-]+$",
   "type": "string"
  },
  "DataAccessRoleArn": {
   "description": "The Amazon Resource Name (ARN) of an IAM role that has permissions to access the Amazon S3 bucket that contains your input file.",
   "format": "AWS::IAM::Role.Arn",
   "maxLength": 2048,
   "minLength": 20,
   "pattern": "^arn:(aws|aws-cn|aws-us-gov|aws-iso-{0,1}[a-z]{0,1}):iam::[0-9]{0,63}:role/[A-Za-z0-9:_/+=,@.-]{0,1024}$",
   "type": "string"
  },
  "LanguageCode": {
   "description": "The language code that represents the language of the entries in your custom vocabulary. Each custom vocabulary must contain terms in only one language.",
   "enum": [
    "ab-GE",
    "af-ZA",
    "am-ET",
    "ar-AE",
    "ar-SA",
    "ast-ES",
    "az-AZ",
    "ba-RU",
