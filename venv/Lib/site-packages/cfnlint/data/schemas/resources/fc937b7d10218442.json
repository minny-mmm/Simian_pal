    "iotsitewise:DescribePipeline",
    "iotsitewise:TagResource",
    "iotsitewise:ListTagsForResource"
   ]
  },
  "delete": {
   "permissions": [
    "iotsitewise:DeletePipeline",
    "iotsitewise:DescribePipeline",
    "iotsitewise:ListTagsForResource"
   ]
  },
  "list": {
   "handlerSchema": {
