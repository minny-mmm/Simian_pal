  "Tags": {
   "description": "Tags associated with the vocabulary filter.",
   "insertionOrder": false,
   "items": {
    "$ref": "#/definitions/Tag"
   },
   "maxItems": 200,
   "minItems": 1,
   "type": "array"
  },
  "VocabularyFilterFileUri": {
   "description": "The Amazon S3 location of the text file that contains your custom vocabulary filter terms.",
   "maxLength": 2000,
   "minLength": 1,
   "pattern": "^(s3://|http(s*)://).+$",
   "type": "string"
  },
  "VocabularyFilterName": {
   "description": "A unique name, chosen by you, for your custom vocabulary filter.",
   "maxLength": 200,
   "minLength": 1,
   "pattern": "^[0-9a-zA-Z._-]+$",
   "type": "string"
  },
  "Words": {
   "description": "Use this parameter if you want to create your custom vocabulary filter by including all desired terms, as comma-separated values, within your request.",
   "insertionOrder": false,
   "items": {
    "maxLength": 256,
    "minLength": 1,
    "type": "string"
   },
   "minItems": 1,
   "type": "array"
  }
 },
 "readOnlyProperties": [
  "/properties/Arn"
 ],
 "required": [
  "VocabularyFilterName",
  "LanguageCode"
 ],
 "tagging": {
  "cloudFormationSystemTags": false,
  "permissions": [
   "transcribe:TagResource",
   "transcribe:UntagResource",
   "transcribe:ListTagsForResource"
  ],
  "tagOnCreate": true,
  "tagProperty": "/properties/Tags",
  "tagUpdatable": true,
  "taggable": true
 },
 "typeName": "AWS::Transcribe::VocabularyFilter",
 "writeOnlyProperties": [
  "/properties/Words",
  "/properties/VocabularyFilterFileUri",
  "/properties/DataAccessRoleArn"
 ]
}
