{
 "additionalIdentifiers": [
  [
   "/properties/VocabularyFilterName"
  ]
 ],
 "additionalProperties": false,
 "createOnlyProperties": [
  "/properties/VocabularyFilterName",
  "/properties/LanguageCode"
 ],
 "definitions": {
  "Tag": {
   "additionalProperties": false,
   "properties": {
    "Key": {
     "description": "The key of the tag.",
     "maxLength": 128,
     "minLength": 1,
     "type": "string"
    },
    "Value": {
     "description": "The value of the tag.",
     "maxLength": 256,
     "minLength": 0,
     "type": "string"
    }
   },
   "required": [
    "Key",
    "Value"
   ],
   "type": "object"
  }
 },
 "description": "Creates a custom vocabulary filter that you can use to mask, delete, or flag specific words from your transcript.",
 "handlers": {
  "create": {
   "permissions": [
    "transcribe:CreateVocabularyFilter",
    "transcribe:GetVocabularyFilter",
    "transcribe:ListTagsForResource",
    "transcribe:TagResource",
    "iam:PassRole"
   ]
  },
  "delete": {
   "permissions": [
    "transcribe:DeleteVocabularyFilter",
    "transcribe:GetVocabularyFilter",
    "transcribe:ListTagsForResource"
   ]
  },
  "list": {
   "permissions": [
    "transcribe:ListVocabularyFilters"
   ]
  },
  "read": {
   "permissions": [
    "transcribe:GetVocabularyFilter",
    "transcribe:ListTagsForResource"
   ]
  },
  "update": {
   "permissions": [
    "transcribe:UpdateVocabularyFilter",
    "transcribe:GetVocabularyFilter",
    "transcribe:TagResource",
    "transcribe:UntagResource",
    "transcribe:ListTagsForResource",
    "iam:PassRole"
   ]
  }
 },
 "primaryIdentifier": [
  "/properties/Arn"
 ],
 "properties": {
  "Arn": {
   "description": "The Amazon Resource Name (ARN) of the vocabulary filter.",
   "type": "string"
  },
  "DataAccessRoleArn": {
   "description": "The Amazon Resource Name (ARN) of an IAM role that has permissions to access the Amazon S3 bucket that contains your input files.",
   "format": "AWS::IAM::Role.Arn",
   "maxLength": 2048,
   "minLength": 20,
   "pattern": "^arn:(aws|aws-cn|aws-us-gov|aws-iso-{0,1}[a-z]{0,1}):iam::[0-9]{0,63}:role/[A-Za-z0-9:_/+=,@.-]{0,1024}$",
   "type": "string"
  },
  "LanguageCode": {
