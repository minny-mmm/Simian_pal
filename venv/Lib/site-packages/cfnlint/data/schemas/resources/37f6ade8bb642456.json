{
 "additionalIdentifiers": [
  [
   "/properties/WorkspaceName",
   "/properties/TaskName"
  ]
 ],
 "additionalProperties": false,
 "createOnlyProperties": [
  "/properties/WorkspaceName",
  "/properties/TaskName"
 ],
 "definitions": {
  "ContainerTaskConfiguration": {
   "additionalProperties": false,
   "description": "Configuration for running a custom container image on managed compute.",
   "properties": {
    "Command": {
     "description": "The command to execute in the container.",
     "insertionOrder": true,
     "items": {
      "type": "string"
     },
     "type": "array"
    },
    "EcrUri": {
     "description": "The Amazon ECR image URI for the task container.",
     "maxLength": 1024,
     "minLength": 1,
     "pattern": "^((\\d{12}\\.dkr\\.ecr\\.[a-z0-9-]+\\.[a-z.]+)|public\\.ecr\\.aws/[a-z][a-z0-9]+([._-][a-z0-9]+)*)/[a-z0-9]+((\\.||__|__|-+)[a-z0-9]+)*(/[a-z0-9]+((\\.||__|__|-+)[a-z0-9]+)*)*(:[a-zA-Z0-9._-]+|@sha256:[a-f0-9]{64})?$",
     "type": "string"
    },
    "EnvironmentVariables": {
     "$ref": "#/definitions/EnvironmentVariablesMap"
    },
    "EphemeralStorageConfiguration": {
     "$ref": "#/definitions/EphemeralStorageConfiguration"
    },
    "Mounts": {
     "description": "Mounts attached to the container filesystem. Each mount exposes an external data source as a local directory inside the container.",
     "insertionOrder": false,
     "items": {
      "$ref": "#/definitions/Mount"
     },
     "maxItems": 5,
     "minItems": 0,
     "type": "array"
    },
    "ProcessingType": {
     "description": "The processing type for compute resources.",
     "enum": [
      "GENERIC_COMPUTE_PROCESSING",
      "HARDWARE_ACCELERATED_PROCESSING"
     ],
     "type": "string"
    },
    "ProcessingUnit": {
     "description": "The processing unit allocation that determines vCPU, memory, and GPU resources.",
     "enum": [
      "UNITS_2",
      "UNITS_4",
      "UNITS_8",
      "UNITS_12",
      "UNITS_16",
      "UNITS_24",
      "UNITS_32",
      "UNITS_36",
      "UNITS_48",
      "UNITS_60",
      "UNITS_64",
      "UNITS_72",
      "UNITS_84",
      "UNITS_96"
     ],
     "type": "string"
    },
    "TaskExecutionRole": {
     "description": "The ARN of the IAM role that grants the containerized workload permissions to access AWS resources.",
     "maxLength": 2048,
     "minLength": 20,
     "pattern": "^arn:[\\w+=\\/,.@-]+:iam::[0-9]+:role/[\\w+=,.@/-]+$",
     "type": "string"
    },
    "TimeoutSeconds": {
     "description": "The timeout in seconds for task execution. Default: 3600 (1 hour).",
     "maximum": 86400,
     "minimum": 60,
     "type": "integer"
    }
   },
   "required": [
    "EcrUri",
    "TaskExecutionRole",
    "ProcessingType",
    "ProcessingUnit"
   ],
   "type": "object"
  },
  "EnvironmentVariablesMap": {
   "additionalProperties": false,
   "description": "A map of environment variable key-value pairs.",
   "maxProperties": 100,
   "patternProperties": {
    "^[a-zA-Z_][a-zA-Z0-9_]*$": {
     "maxLength": 2048,
     "type": "string"
    }
   },
   "type": "object"
  },
  "EphemeralStorageConfiguration": {
   "additionalProperties": false,
   "description": "Configuration for ephemeral storage attached to the container task.",
   "properties": {
    "StorageClass": {
     "description": "The storage type that determines I/O performance characteristics. Family name indicates workload pattern, level number indicates performance within that family.",
     "enum": [
      "STANDARD_1",
      "STANDARD_2",
      "THROUGHPUT_1",
      "THROUGHPUT_2"
     ],
     "type": "string"
    },
    "StorageSizeInGiB": {
     "description": "Storage volume size in GiB.",
     "maximum": 16384,
     "minimum": 1,
     "type": "integer"
    }
   },
   "required": [
    "StorageClass",
    "StorageSizeInGiB"
   ],
   "type": "object"
  },
  "Mount": {
   "additionalProperties": false,
   "description": "Attaches a data source to the container filesystem for a task at a customer-supplied relative path under the service-owned mount root.",
   "properties": {
    "Name": {
     "description": "A unique name for the mount within the task.",
     "maxLength": 64,
     "minLength": 1,
     "pattern": "^[a-zA-Z0-9_-]+$",
     "type": "string"
    },
    "RelativePath": {
     "description": "The relative path under the service-owned mount root where this mount is attached inside the container.",
     "maxLength": 1024,
     "minLength": 1,
     "pattern": "^((?!.*(^|/)\\.\\.?(/|$))(?!.*//)[a-zA-Z0-9._-][a-zA-Z0-9._/-]*[a-zA-Z0-9._-]|[a-zA-Z0-9_-])$",
     "type": "string"
    },
    "Source": {
     "$ref": "#/definitions/MountSource"
    },
    "StorageType": {
     "description": "The type of storage used for the mount inside the container.",
     "enum": [
      "SHARED_STORAGE"
     ],
     "type": "string"
    }
   },
   "required": [
    "Name",
    "RelativePath",
    "Source",
    "StorageType"
   ],
   "type": "object"
  },
  "MountSource": {
   "additionalProperties": false,
   "description": "The data source configuration for a mount.",
   "properties": {
    "S3AccessPoint": {
     "$ref": "#/definitions/S3AccessPointSource"
    }
   },
   "required": [
    "S3AccessPoint"
   ],
   "type": "object"
  },
  "S3AccessPointSource": {
   "additionalProperties": false,
   "description": "Configures a mount that reads from an Amazon S3 access point.",
   "properties": {
    "AccessPointArn": {
     "description": "The Amazon Resource Name (ARN) of the Amazon S3 access point. The mount reads objects from the bucket associated with this access point. Access is governed by the access point policy and the task execution role's IAM permissions.",
     "maxLength": 128,
     "minLength": 4,
     "pattern": "^arn:aws(-cn|-us-gov)?:s3:[a-z0-9-]*:\\d{12}:accesspoint[/:][a-zA-Z0-9._-]+$",
     "type": "string"
    },
    "Prefix": {
     "description": "An object key name prefix. If specified, the mount includes only objects whose keys begin with this prefix. To include all objects at the access point, omit this field.",
     "maxLength": 1024,
     "minLength": 1,
     "type": "string"
    }
   },
   "required": [
    "AccessPointArn"
   ],
   "type": "object"
  },
  "Tag": {
   "additionalProperties": false,
   "description": "A key-value pair to associate with a resource.",
   "properties": {
    "Key": {
     "description": "The key name of the tag.",
     "maxLength": 128,
     "minLength": 1,
     "type": "string"
    },
    "Value": {
     "description": "The value for the tag.",
     "maxLength": 256,
     "minLength": 0,
     "type": "string"
    }
   },
   "required": [
    "Key",
    "Value"
   ],
   "type": "object"
  },
  "TaskConfiguration": {
   "additionalProperties": false,
   "description": "The task execution configuration.",
   "properties": {
    "ContainerTaskConfiguration": {
     "$ref": "#/definitions/ContainerTaskConfiguration"
    }
   },
   "required": [
    "ContainerTaskConfiguration"
   ],
   "type": "object"
  }
 },
 "description": "Resource schema for AWS::IoTSiteWise::Task. A task defines a reusable containerized compute workload that can be referenced by one or more pipeline compute nodes.",
 "handlers": {
  "create": {
   "permissions": [
    "iotsitewise:CreateTask",
    "iotsitewise:DescribeTask",
    "iotsitewise:TagResource",
    "iotsitewise:ListTagsForResource",
    "iam:PassRole"
   ]
  },
  "delete": {
   "permissions": [
    "iotsitewise:DeleteTask",
    "iotsitewise:DescribeTask",
    "iotsitewise:ListTagsForResource"
   ]
  },
  "list": {
   "handlerSchema": {
    "properties": {
     "WorkspaceName": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9_-]+$",
      "type": "string"
     }
    },
    "required": [
     "WorkspaceName"
    ]
   },
   "permissions": [
    "iotsitewise:ListTasks"
   ]
  },
  "read": {
   "permissions": [
    "iotsitewise:DescribeTask",
    "iotsitewise:ListTagsForResource"
   ]
  },
  "update": {
   "permissions": [
    "iotsitewise:UpdateTask",
    "iotsitewise:DescribeTask",
    "iotsitewise:TagResource",
    "iotsitewise:UntagResource",
    "iotsitewise:ListTagsForResource",
    "iam:PassRole"
   ]
  }
 },
 "primaryIdentifier": [
  "/properties/TaskArn"
 ],
 "properties": {
  "Description": {
   "description": "A description of the task.",
   "maxLength": 2048,
   "minLength": 0,
   "pattern": "^[^\\u0000-\\u001F\\u007F]+$",
   "type": "string"
  },
  "Status": {
   "description": "The current lifecycle status of the task.",
   "enum": [
    "ACTIVE",
    "CREATING",
    "UPDATING",
    "DELETING",
    "FAILED"
   ],
   "type": "string"
  },
  "Tags": {
   "description": "An array of key-value pairs to apply to this resource.",
   "insertionOrder": false,
   "items": {
    "$ref": "#/definitions/Tag"
   },
   "maxItems": 50,
   "type": "array"
  },
  "TaskArn": {
   "description": "The ARN of the task.",
   "maxLength": 2048,
   "minLength": 1,
   "pattern": "^arn:[\\w+=\\/,.@-]+:[\\w+=\\/,.@-]+:[\\w+=\\/,.@-]*:[0-9]+:[\\w+=\\/,.@-]+$",
   "type": "string"
  },
  "TaskConfiguration": {
   "$ref": "#/definitions/TaskConfiguration",
   "description": "The task execution configuration."
  },
  "TaskName": {
   "description": "The name of the task. Must be unique within the workspace.",
   "maxLength": 128,
   "minLength": 1,
   "pattern": "^[a-zA-Z0-9_-]+$",
   "type": "string"
  },
  "WorkspaceName": {
   "description": "The name of the workspace.",
   "maxLength": 128,
   "minLength": 1,
   "pattern": "^[a-zA-Z0-9_-]+$",
   "type": "string"
  }
 },
 "readOnlyProperties": [
  "/properties/TaskArn",
  "/properties/Status"
 ],
 "required": [
  "WorkspaceName",
  "TaskName",
  "TaskConfiguration"
 ],
 "sourceUrl": "https://github.com/aws-cloudformation/aws-cloudformation-resource-providers-iotsitewise",
 "tagging": {
  "cloudFormationSystemTags": true,
  "permissions": [
   "iotsitewise:TagResource",
   "iotsitewise:UntagResource",
   "iotsitewise:ListTagsForResource"
  ],
  "tagOnCreate": true,
  "tagProperty": "/properties/Tags",
  "tagUpdatable": true,
  "taggable": true
 },
 "typeName": "AWS::IoTSiteWise::Task"
}
