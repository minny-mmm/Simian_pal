  "cloudFormationSystemTags": false,
  "permissions": [
   "redshift:CreateTags",
   "redshift:DeleteTags",
   "redshift:DescribeRedshiftIdcApplications"
  ],
  "tagOnCreate": true,
  "tagProperty": "/properties/Tags",
  "tagUpdatable": true,
  "taggable": true
 },
 "typeName": "AWS::Redshift::RedshiftIdcApplication",
 "writeOnlyProperties": [
