   "permissions": [
    "appfabric:CreateAppAuthorization",
    "appfabric:TagResource"
   ]
  },
  "delete": {
   "permissions": [
    "appfabric:DeleteAppAuthorization"
   ]
  },
  "list": {
   "handlerSchema": {
    "properties": {
     "AppBundleIdentifier": {
      "maxLength": 1011,
      "minLength": 1,
      "pattern": "^arn:.+$|^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$",
      "type": "string"
     }
    },
    "required": [
     "AppBundleIdentifier"
    ]
   },
   "permissions": [
    "appfabric:ListAppAuthorizations"
   ]
  },
  "read": {
   "permissions": [
    "appfabric:GetAppAuthorization",
    "appfabric:ListTagsForResource"
   ]
  },
  "update": {
   "permissions": [
    "appfabric:UpdateAppAuthorization",
    "appfabric:GetAppAuthorization",
    "appfabric:ListTagsForResource",
    "appfabric:TagResource",
    "appfabric:UntagResource"
   ]
  }
 },
 "primaryIdentifier": [
  "/properties/AppAuthorizationArn"
 ],
 "properties": {
  "App": {
   "description": "The name of the application.",
   "maxLength": 255,
   "minLength": 1,
   "type": "string"
  },
  "AppAuthorizationArn": {
   "description": "The Amazon Resource Name (ARN) of the app authorization.",
   "maxLength": 1011,
   "minLength": 1,
   "pattern": "^arn:.+$",
   "type": "string"
  },
  "AppAuthorizationIdentifier": {
   "description": "The unique identifier of the app authorization.",
   "maxLength": 1011,
   "minLength": 1,
   "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$",
   "type": "string"
  },
  "AppBundleArn": {
   "description": "The Amazon Resource Name (ARN) of the app bundle for the app authorization.",
   "maxLength": 1011,
   "minLength": 1,
   "pattern": "^arn:.+$",
   "type": "string"
  },
  "AppBundleIdentifier": {
   "description": "The Amazon Resource Name (ARN) or Universal Unique Identifier (UUID) of the app bundle to use for the request.",
   "maxLength": 1011,
   "minLength": 1,
   "pattern": "^arn:.+$|^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$",
   "type": "string"
  },
  "AuthType": {
   "description": "The authorization type.",
   "enum": [
    "oauth2",
    "apiKey"
   ],
   "type": "string"
  },
  "CreatedAt": {
   "description": "The timestamp of when the app authorization was created.",
   "format": "date-time",
   "type": "string"
  },
  "Credential": {
   "$ref": "#/definitions/Credential",
   "description": "Contains credentials for the application."
  },
  "Persona": {
   "description": "The user persona of the app authorization.",
   "enum": [
    "admin",
    "endUser"
   ],
   "type": "string"
  },
  "Status": {
   "description": "The state of the app authorization.",
   "enum": [
    "PendingConnect",
    "Connected",
    "ConnectionValidationFailed",
    "TokenAutoRotationFailed"
   ],
   "type": "string"
  },
  "Tags": {
   "description": "Tags to apply to the app authorization.",
   "insertionOrder": false,
   "items": {
    "$ref": "#/definitions/Tag"
   },
   "maxItems": 50,
   "minItems": 0,
   "type": "array",
   "uniqueItems": true
  },
  "Tenant": {
   "$ref": "#/definitions/Tenant",
   "description": "Contains information about an application tenant."
  },
  "UpdatedAt": {
   "description": "The timestamp of when the app authorization was last updated.",
   "format": "date-time",
   "type": "string"
  }
 },
