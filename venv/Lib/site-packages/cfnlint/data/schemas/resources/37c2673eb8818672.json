     "description": "The number of MIG partitions of the specified Type allocated to the team.",
     "maximum": 10000000,
     "minimum": 0,
     "type": "integer"
    },
    "Type": {
     "description": "MIG profile type. Service rejects MIG profiles that the chosen InstanceType does not support.",
     "enum": [
      "mig-1g.5gb",
      "mig-1g.10gb",
      "mig-1g.18gb",
