  "ComputeQuotaTarget": {
   "additionalProperties": false,
   "description": "The team this compute allocation rule applies to.",
   "properties": {
    "FairShareWeight": {
     "description": "Relative fair-share weight when fair-share scheduling is enabled on the parent ClusterSchedulerConfig. Defaults service-side to 0 when omitted.",
     "maximum": 100,
     "minimum": 0,
     "type": "integer"
    },
    "TeamName": {
     "description": "The name of the team. Materialized as Kubernetes namespace 'hyperpod-ns-<TeamName>' on the EKS cluster, so the value must satisfy RFC 1123 namespace constraints. Reassignment is not supported (createOnly).",
     "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9]){0,39}?$",
     "type": "string"
    }
   },
   "required": [
    "TeamName"
   ],
   "type": "object"
  },
  "ResourceSharingConfig": {
   "additionalProperties": false,
   "description": "Idle-resource-sharing strategy for this team's quota.",
   "properties": {
    "AbsoluteBorrowLimits": {
     "description": "Per-instance-type absolute caps on resources this team can borrow.",
     "insertionOrder": false,
     "items": {
      "$ref": "#/definitions/ComputeQuotaResourceConfig"
     },
     "maxItems": 15,
     "minItems": 0,
     "type": "array"
    },
    "BorrowLimit": {
     "description": "Maximum percentage of the team's idle quota that can be borrowed by other teams. Smithy admits 0..10000; in practice the service-documented operational range is 1..500. Defaults service-side to 50 when omitted on Create.",
     "maximum": 10000,
     "minimum": 0,
     "type": "integer"
    },
    "Strategy": {
     "description": "How this team participates in idle-resource sharing.",
     "enum": [
      "Lend",
      "DontLend",
      "LendAndBorrow"
     ],
     "type": "string"
    }
   },
