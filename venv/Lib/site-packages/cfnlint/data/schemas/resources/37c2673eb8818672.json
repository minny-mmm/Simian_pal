   "type": "object"
  },
  "ComputeQuotaConfig": {
   "additionalProperties": false,
   "description": "Compute allocation rules: per-resource quotas, idle-borrowing strategy, and team-task preemption policy.",
   "properties": {
    "ComputeQuotaResources": {
     "description": "Per-instance-type compute quotas for the team. When VCpu / MemoryInGiB / Accelerators are partially specified, SageMaker auto-fills the remaining fields ratio-proportionally to the underlying instance \u2014 Read may return values the customer did not supply (drift may flag this).",
     "insertionOrder": false,
     "items": {
      "$ref": "#/definitions/ComputeQuotaResourceConfig"
     },
     "maxItems": 15,
     "minItems": 0,
     "type": "array"
    },
    "PreemptTeamTasks": {
     "description": "Team-task preemption policy. Defaults service-side to 'LowerPriority' when omitted on Create.",
     "enum": [
      "Never",
      "LowerPriority"
     ],
     "type": "string"
    },
    "ResourceSharingConfig": {
     "$ref": "#/definitions/ResourceSharingConfig",
     "description": "Idle-resource-sharing strategy for this team's quota. When omitted, the service applies defaults (Strategy=LendAndBorrow, BorrowLimit=50)."
    }
   },
   "type": "object"
  },
  "ComputeQuotaResourceConfig": {
